@model List<AuditEntry>
@{ ViewData["Title"] = "Audit log"; int page = ViewBag.Page; }
<h1 class="h3 mb-3">Audit log</h1>
<form method="get" class="row g-2 mb-3">
    <div class="col-sm-6"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Search action, person or details" /></div>
    <div class="col-sm-2"><button class="btn btn-outline-primary w-100">Search</button></div>
</form>
<div class="card">
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead><tr><th>When</th><th>Who</th><th>Action</th><th>Details</th></tr></thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr><td>@a.At.ToLocalTime().ToString("d MMM yyyy HH:mm")</td><td>@a.UserName</td><td>@a.Action</td><td style="white-space:normal">@a.Details</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
<div class="mt-2 d-flex gap-2">
    @if (page > 1) { <a class="btn btn-sm btn-outline-secondary" asp-route-q="@ViewBag.Q" asp-route-page="@(page - 1)">Newer</a> }
    @if (ViewBag.HasMore) { <a class="btn btn-sm btn-outline-secondary" asp-route-q="@ViewBag.Q" asp-route-page="@(page + 1)">Older</a> }
</div>
