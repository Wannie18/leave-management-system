@model EmployeeBalanceViewModel
@{ ViewData["Title"] = $"{Model.Employee.FullName}: balances"; }
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">@Model.Employee.FullName, @Model.Year</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary btn-sm" asp-route-id="@Model.Employee.Id" asp-route-year="@(Model.Year - 1)">&larr; @(Model.Year - 1)</a>
        <a class="btn btn-outline-secondary btn-sm" asp-route-id="@Model.Employee.Id" asp-route-year="@(Model.Year + 1)">@(Model.Year + 1) &rarr;</a>
        <a class="btn btn-outline-primary btn-sm" asp-controller="Leave" asp-action="Record" asp-route-userId="@Model.Employee.Id">Record leave</a>
    </div>
</div>
<p class="text-muted">@Model.Employee.Department?.Name &middot; Supervisor: @(Model.Employee.Supervisor?.FullName ?? "none") &middot; Started @Model.Employee.StartDate.ToString("d MMM yyyy")</p>

<div class="card p-3 mb-4">
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead><tr><th>Leave type</th><th class="text-end">Eligible</th><th class="text-end">Brought forward</th><th class="text-end">Adjustments</th><th class="text-end">Taken</th><th class="text-end">Pending</th><th class="text-end">Remaining</th></tr></thead>
            <tbody>
                @foreach (var b in Model.Balances)
                {
                    <tr><td>@b.LeaveType.Name</td><td class="text-end">@b.Entitlement.ToString("0.#")</td><td class="text-end">@b.BroughtForward.ToString("0.#")</td><td class="text-end">@b.Adjustments.ToString("0.#")</td><td class="text-end">@b.Taken.ToString("0.#")</td><td class="text-end">@b.Pending.ToString("0.#")</td><td class="text-end fw-semibold">@b.Remaining.ToString("0.#")</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card p-4">
            <h2 class="h6">Adjust a balance</h2>
            <form asp-action="Adjust" method="post">
                <input type="hidden" name="UserId" value="@Model.Employee.Id" />
                <input type="hidden" name="Year" value="@Model.Year" />
                <div class="mb-2"><label class="form-label small">Leave type</label><select name="LeaveTypeId" asp-items="ViewBag.LeaveTypes" class="form-select form-select-sm"></select></div>
                <div class="row">
                    <div class="col-6 mb-2"><label class="form-label small">Set eligible days to</label><input name="Entitlement" type="number" step="0.5" class="form-control form-control-sm" /></div>
                    <div class="col-6 mb-2"><label class="form-label small">Set brought forward to</label><input name="BroughtForward" type="number" step="0.5" class="form-control form-control-sm" /></div>
                </div>
                <div class="mb-2"><label class="form-label small">Add or remove days (minus to remove)</label><input name="Days" type="number" step="0.5" class="form-control form-control-sm" /></div>
                <div class="mb-3"><label class="form-label small required">Reason</label><input name="Reason" class="form-control form-control-sm" required maxlength="300" /></div>
                <button class="btn btn-sm btn-primary">Save adjustment</button>
                <div class="form-text">Leave a field empty to keep it as it is. Every change is recorded in the audit log.</div>
            </form>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card p-3 mb-3">
            <h2 class="h6">Adjustments in @Model.Year</h2>
            @if (!Model.Adjustments.Any()) { <p class="text-muted small mb-0">None.</p> }
            else
            {
                <table class="table table-sm mb-0">
                    <thead><tr><th>Date</th><th>Type</th><th class="text-end">Days</th><th>Reason</th><th>By</th></tr></thead>
                    <tbody>@foreach (var a in Model.Adjustments) { <tr><td>@a.CreatedAt.ToLocalTime().ToString("d MMM")</td><td>@a.LeaveType!.Name</td><td class="text-end">@a.Days.ToString("+0.#;-0.#")</td><td class="small" style="white-space:normal">@a.Reason</td><td class="small">@a.ByUser?.FullName</td></tr> }</tbody>
                </table>
            }
        </div>
        <div class="card p-3">
            <h2 class="h6">Requests in @Model.Year</h2>
            @if (!Model.Requests.Any()) { <p class="text-muted small mb-0">None.</p> }
            else
            {
                <table class="table table-sm mb-0">
                    <thead><tr><th>Type</th><th>Dates</th><th class="text-end">Days</th><th>Status</th></tr></thead>
                    <tbody>@foreach (var r in Model.Requests) { <tr><td><a asp-controller="Leave" asp-action="Details" asp-route-id="@r.Id">@r.LeaveType!.Name</a></td><td>@LeaveService.Dates(r)</td><td class="text-end">@r.Days.ToString("0.#")</td><td><partial name="_StatusBadge" model="r.Status" /></td></tr> }</tbody>
                </table>
            }
        </div>
    </div>
</div>
