@model List<ApplicationUser>
@{ ViewData["Title"] = "Employees"; }
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Employees (@Model.Count)</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary btn-sm" asp-controller="Setup" asp-action="Import">Import from spreadsheet</a>
        <a class="btn btn-primary btn-sm" asp-action="Create">Add employee</a>
    </div>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-sm-4"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Search name, email or number" /></div>
    <div class="col-sm-3"><select name="departmentId" asp-items="ViewBag.Departments" class="form-select"><option value="">All departments</option></select></div>
    <div class="col-sm-3 d-flex align-items-center"><div class="form-check"><input class="form-check-input" type="checkbox" name="showInactive" value="true" id="inactive" @(ViewBag.ShowInactive ? "checked" : "") /><label class="form-check-label" for="inactive">Include inactive</label></div></div>
    <div class="col-sm-2"><button class="btn btn-outline-primary w-100">Filter</button></div>
</form>
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>Name</th><th>Number</th><th>Department</th><th>Supervisor</th><th>Email</th><th></th></tr></thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr class="@(u.IsActive ? "" : "text-muted")">
                        <td>@u.FullName @if (!u.IsActive) { <span class="badge bg-secondary">Inactive</span> }<div class="small text-muted">@u.JobTitle</div></td>
                        <td>@u.EmployeeNumber</td>
                        <td>@u.Department?.Name</td>
                        <td>@(u.Supervisor?.FullName ?? "None (HR approves)")</td>
                        <td class="small">@u.Email</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Balances" asp-route-id="@u.Id">Balances</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@u.Id">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
