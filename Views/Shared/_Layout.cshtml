@inject Microsoft.Extensions.Options.IOptions<AppSettings> AppOptions
@{
    var org = AppOptions.Value.OrganizationName;
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isHr = User.IsInRole(Roles.HR) || User.IsInRole(Roles.Admin);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#7b1e2b" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="~/img/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png" />
    <title>@ViewData["Title"] - @org Leave</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="d-print-none">
        <nav class="navbar navbar-expand-lg navbar-dark brand-navbar mb-4">
            <div class="container">
                <a class="navbar-brand fw-semibold d-flex align-items-center" asp-controller="Home" asp-action="Index"><img src="~/img/rfp-logo.png" asp-append-version="true" alt="@org logo" class="brand-logo" /> <span>Leave</span></a>
                @if (signedIn)
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="mainNav">
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item"><a class="nav-link" asp-controller="Leave" asp-action="Apply">Apply for leave</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Leave" asp-action="Index">My leave</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Approvals" asp-action="Index">Approvals</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Calendar">Calendar</a></li>
                            @if (isHr)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">HR</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Employees" asp-action="Index">Employees</a></li>
                                        <li><a class="dropdown-item" asp-controller="Leave" asp-action="Record">Record leave for someone</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" asp-controller="Reports" asp-action="Balances">Balance report</a></li>
                                        <li><a class="dropdown-item" asp-controller="Reports" asp-action="Taken">Leave report</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" asp-controller="Setup" asp-action="LeaveTypes">Leave types and rules</a></li>
                                        <li><a class="dropdown-item" asp-controller="Setup" asp-action="Holidays">Public holidays</a></li>
                                        <li><a class="dropdown-item" asp-controller="Setup" asp-action="YearEnd">Year-end carry forward</a></li>
                                        <li><a class="dropdown-item" asp-controller="Setup" asp-action="Import">Import spreadsheet</a></li>
                                        @if (User.IsInRole(Roles.Admin))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Setup" asp-action="Audit">Audit log</a></li>
                                        }
                                    </ul>
                                </li>
                            }
                        </ul>
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Notifications" asp-action="Index" title="Notifications">
                                    Notifications
                                    @{ var badge = await Component.InvokeAsync("NotificationBadge"); }
                                    <span class="badge rounded-pill">@badge</span>
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">@User.Identity!.Name</a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Approvals" asp-action="Delegate">Delegate approvals</a></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">Change password</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">Sign out</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-5">
            <partial name="_Flash" />
            @RenderBody()
        </main>
    </div>
    <footer class="brand-footer py-3 small d-print-none">
        <div class="container d-flex align-items-center gap-3"><img src="~/img/rfp-logo.png" asp-append-version="true" alt="" class="footer-logo" /> <span>@org Leave Management System</span></div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
