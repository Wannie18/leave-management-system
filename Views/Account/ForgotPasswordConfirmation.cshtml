@{ ViewData["Title"] = "Check your email"; }
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card p-4 mt-4">
            <h1 class="h4">Check your email</h1>
            <p>If that address belongs to an active account, a reset link is on its way. If nothing arrives within a few minutes, ask HR to reset your password.</p>
            <a asp-action="Login">Back to sign in</a>
        </div>
    </div>
</div>
